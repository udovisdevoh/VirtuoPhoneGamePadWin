<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Exe (not WinExe) keeps a console for the logs / headless mode (VP_HEADLESS=1); the UI still runs. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>

  <!-- Ship the sample bank next to the exe so the audio engine can load res/raw/<name>.ogg. -->
  <ItemGroup>
    <None Update="res\raw\*.ogg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The test project lives under Tests/ but is a separate project; don't compile its files here. -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

</Project>
